COUCHDB_USER=admin
COUCHDB_DATABASE=starintel
RABBITMQ_USER=starintel

STAR_SERVER_BIND_ADDRESS=127.0.0.1
STAR_SERVER_PORT=5000
COUCHDB_BIND_ADDRESS=127.0.0.1
COUCHDB_PORT=5984
RABBITMQ_BIND_ADDRESS=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# No human administrator is created unless an initial password is explicitly
# configured. Prefer a secret file in deployed environments. The one-time
# /auth/bootstrap API-key flow remains available on an empty auth store.
STAR_AUTH_INITIAL_USERNAME=star
# STAR_AUTH_INITIAL_PASSWORD_FILE=./secrets/auth_initial_password
STAR_AUTH_PASSWORD_MIN_LENGTH=12
STAR_AUTH_PASSWORD_ITERATIONS=600000
STAR_AUTH_LOGIN_SESSION_SECONDS=86400

CREDENTIALS_DIR=./secrets
CLOUSEAU_JAVA_OPTS=-Xms256m -Xmx1g
