{"_id":"_design/users","views":{"by_name":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='user'&&doc.name){emit(doc.name,doc._id);}}}"},"by_platform":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='user'&&doc.platform){emit(doc.platform,doc._id);}}}"},"by_url":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='user'&&doc.url){emit(doc.url,doc._id);}}}"},"by_platform_and_name":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='user'&&doc.platform&&doc.name){emit([doc.platform,doc.name],doc._id);}}}"},"count_by_platform":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='user'&&doc.platform){emit(doc.platform,1);}}}","reduce":"_count"}},"language":"javascript"}
