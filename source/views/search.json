{"_id":"_design/search","views":{},"language":"javascript","indexes":{"fts":{"analyzer":{"name":"perfield","default":"standard","fields":{"content":"standard","name":"keyword"}},"index":"function(doc){var fields=['fname','lname','full_name','content','user','name','display_name','legal_name','group','channel','platform','domain','url','target','claim','term','org_type'];var data=doc.data||{};index('dataset',doc.dataset,{'store':true});index('dtype',doc.dtype,{'store':true});if(doc.title){index('title',doc.title,{'store':true});}if(doc.summary){index('summary',doc.summary,{'store':true});}if(Array.isArray(doc.sources)){doc.sources.forEach(function(source){if(typeof source==='string'){index('sources',source,{'store':true});}else if(source&&typeof source==='object'){['name','title','url','uri','publisher','author'].forEach(function(key){if(source[key]!==undefined){index('sources',source[key],{'store':true});}});}});}fields.forEach(function(field){var value=data[field]!==undefined?data[field]:doc[field];if(value!==undefined&&value!==null){index(field,value,{'store':true});}});if(doc.schema_org&&doc.schema_org.sameAs){index('sameAs',doc.schema_org.sameAs,{'store':true});}}"}}}
