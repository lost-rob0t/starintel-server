{"_id":"_design/relations","views":{"edges":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='relation'){emit(doc.target,{\"_id\":doc._id,\"note\":doc.note});}}}","reduce":"function(keys,values,rereduce){var results=[];if(!rereduce){values.forEach(function(value){if(results.indexOf(value)===-1){results.push(value);}});}else{values.forEach(function(arr){arr.forEach(function(value){if(results.indexOf(value)===-1){results.push(value);}});});}return results;}"},"neighbors":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='relation'){emit(doc.source,doc.target);}}}","reduce":"function(keys,values,rereduce){var results=[];if(!rereduce){values.forEach(function(value){if(results.indexOf(value)===-1){results.push(value);}});}else{values.forEach(function(arr){arr.forEach(function(value){if(results.indexOf(value)===-1){results.push(value);}});});}return results;}"},"outgoing_count":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='relation'){emit(doc.source,1);}}}","reduce":"_count"},"incoming_count":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='relation'){emit(doc.target,1);}}}","reduce":"_count"}},"language":"javascript"}
