{"_id":"_design/relations","views":{"by_source":{"map":"function(doc){if(!doc||!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='relation')return;if(!doc.source||!doc.target)return;var p=doc.predicate||'related-to';emit(doc.source,{_id:doc._id,target:doc.target,predicate:p,note:doc.note||''});}"},"by_target":{"map":"function(doc){if(!doc||!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='relation')return;if(!doc.source||!doc.target)return;var p=doc.predicate||'related-to';emit(doc.target,{_id:doc._id,source:doc.source,predicate:p,note:doc.note||''});}"},"by_source_target":{"map":"function(doc){if(!doc||!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='relation')return;if(!doc.source||!doc.target)return;var p=doc.predicate||'related-to';emit([doc.source,doc.target],{_id:doc._id,predicate:p,note:doc.note||''});}"},"by_predicate":{"map":"function(doc){if(!doc||!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='relation')return;if(!doc.source||!doc.target)return;var p=doc.predicate||'related-to';emit(p,{_id:doc._id,source:doc.source,target:doc.target,note:doc.note||''});}"},"by_source_predicate":{"map":"function(doc){if(!doc||!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='relation')return;if(!doc.source||!doc.target)return;var p=doc.predicate||'related-to';emit([doc.source,p],{_id:doc._id,target:doc.target,note:doc.note||''});}"},"by_target_predicate":{"map":"function(doc){if(!doc||!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='relation')return;if(!doc.source||!doc.target)return;var p=doc.predicate||'related-to';emit([doc.target,p],{_id:doc._id,source:doc.source,note:doc.note||''});}"},"outgoing_count":{"map":"function(doc){if(!doc||!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt==='relation'&&doc.source&&doc.target)emit(doc.source,1);}","reduce":"_count"},"incoming_count":{"map":"function(doc){if(!doc||!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt==='relation'&&doc.source&&doc.target)emit(doc.target,1);}","reduce":"_count"},"count_by_predicate":{"map":"function(doc){if(!doc||!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='relation')return;if(!doc.source||!doc.target)return;var p=doc.predicate||'related-to';emit(p,1);}","reduce":"_count"},"count_by_source_predicate":{"map":"function(doc){if(!doc||!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='relation')return;if(!doc.source||!doc.target)return;var p=doc.predicate||'related-to';emit([doc.source,p],1);}","reduce":"_count"},"count_by_target_predicate":{"map":"function(doc){if(!doc||!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='relation')return;if(!doc.source||!doc.target)return;var p=doc.predicate||'related-to';emit([doc.target,p],1);}","reduce":"_count"},"neighbors":{"map":"function(doc){if(!doc||!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='relation')return;if(!doc.source||!doc.target)return;emit(doc.source,doc.target);}","reduce":"function(keys,values,rereduce){var out=[],seen={};if(!rereduce){for(var i=0;i<values.length;i++){var v=values[i];if(!seen[v]){seen[v]=1;out.push(v);}}}else{for(var j=0;j<values.length;j++){var arr=values[j];for(var k=0;k<arr.length;k++){var vv=arr[k];if(!seen[vv]){seen[vv]=1;out.push(vv);}}}}return out;}"},"neighbors_by_predicate":{"map":"function(doc){if(!doc||!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='relation')return;if(!doc.source||!doc.target)return;var p=doc.predicate||'related-to';emit([doc.source,p],doc.target);}","reduce":"function(keys,values,rereduce){var out=[],seen={};if(!rereduce){for(var i=0;i<values.length;i++){var v=values[i];if(!seen[v]){seen[v]=1;out.push(v);}}}else{for(var j=0;j<values.length;j++){var arr=values[j];for(var k=0;k<arr.length;k++){var vv=arr[k];if(!seen[vv]){seen[vv]=1;out.push(vv);}}}}return out;}"}},"language":"javascript"}
