{"_id":"_design/relations","language":"javascript","views":{"edges":{"map":"function(doc){function v(k){return doc.data&&doc.data[k]!==undefined?doc.data[k]:doc[k];}if(doc.dtype==='relation'){emit(v('object')||v('target'),{'_id':doc._id,'note':v('note')});}}","reduce":"function(keys,values,rereduce){var results=[];function add(value){if(results.indexOf(value)===-1){results.push(value);}}values.forEach(function(value){if(rereduce&&Array.isArray(value)){value.forEach(add);}else{add(value);}});return results;}"},"neighbors":{"map":"function(doc){function v(k){return doc.data&&doc.data[k]!==undefined?doc.data[k]:doc[k];}if(doc.dtype==='relation'){emit(v('subject')||v('source'),v('object')||v('target'));}}","reduce":"function(keys,values,rereduce){var results=[];function add(value){if(results.indexOf(value)===-1){results.push(value);}}values.forEach(function(value){if(rereduce&&Array.isArray(value)){value.forEach(add);}else{add(value);}});return results;}"},"outgoing_count":{"map":"function(doc){function v(k){return doc.data&&doc.data[k]!==undefined?doc.data[k]:doc[k];}if(doc.dtype==='relation'){emit(v('subject')||v('source'),1);}}","reduce":"_count"},"incoming_count":{"map":"function(doc){function v(k){return doc.data&&doc.data[k]!==undefined?doc.data[k]:doc[k];}if(doc.dtype==='relation'){emit(v('object')||v('target'),1);}}","reduce":"_count"}}}
