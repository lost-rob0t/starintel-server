{"_id":"_design/networks","views":{"by_asn":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='network'&&doc.asn){emit(doc.asn,doc._id);}}}"},"by_org":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='network'&&doc.org){emit(doc.org,doc._id);}}}"},"by_subnet":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='network'&&doc.subnet){emit(doc.subnet,doc._id);}}}"},"count_by_org":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='network'&&doc.org){emit(doc.org,1);}}}","reduce":"_count"}},"language":"javascript"}
