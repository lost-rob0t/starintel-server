{"_id":"_design/email-messages","views":{"by_from":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='email-message'&&doc.from){emit(doc.from,doc._id);}}}"},"by_to":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='email-message'&&doc.to){emit(doc.to,doc._id);}}}"},"by_subject":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='email-message'&&doc.subject){emit(doc.subject,doc._id);}}}"},"by_participant":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='emailmessage'){if(doc.from)emit(doc.from,doc._id);if(doc.to)emit(doc.to,doc._id);}}}"}},"language":"javascript"}
