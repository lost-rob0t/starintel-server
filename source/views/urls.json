{"_id":"_design/urls","views":{"by_url":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='url'&&doc.url){emit(doc.url,doc._id);}}}"},"by_path":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='url'&&doc.path){emit(doc.path,doc._id);}}}"},"by_domain":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='url'&&doc.url){var s=(''+doc.url);var host='';var m=s.match(/^[a-zA-Z][a-zA-Z0-9+.-]*:\\/\\/([^\\/?#:]+)/);if(m&&m[1]){host=m[1];}else{m=s.match(/^([^\\/?#:]+)/);if(m&&m[1]){host=m[1];}}if(host){emit(host,doc._id);}}}}"},"count_by_path":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='url'&&doc.path){emit(doc.path,1);}}}","reduce":"_count"}},"language":"javascript"}
