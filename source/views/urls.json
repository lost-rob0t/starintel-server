{"_id":"_design/urls","views":{"by_url":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='url'&&doc.url){emit(doc.url,doc._id);}}}"},"by_path":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='url'&&doc.path){emit(doc.path,doc._id);}}}"},"by_domain":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='url'&&doc.url){try{var u=new URL(doc.url);emit(u.hostname,doc._id);}catch(e){}}}}"},"count_by_path":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='url'&&doc.path){emit(doc.path,1);}}}","reduce":"_count"}},"language":"javascript"}
