{"_id":"_design/hosts","views":{"by_ip":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='host'&&doc.ip){emit(doc.ip,doc._id);}}}"},"by_hostname":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='host'&&doc.hostname){emit(doc.hostname,doc._id);}}}"},"by_port":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='host'&&doc.ports&&Array.isArray(doc.ports)){for(var i=0;i<doc.ports.length;i++){if(doc.ports[i].port){emit(doc.ports[i].port,doc._id);}}}}}"},"by_service":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='host'&&doc.ports&&Array.isArray(doc.ports)){for(var i=0;i<doc.ports.length;i++){if(doc.ports[i].name){emit(doc.ports[i].name,doc._id);}}}}}"},"by_os":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='host'&&doc.os){emit(doc.os,doc._id);}}}"},"count_by_os":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='host'&&doc.os){emit(doc.os,1);}}}","reduce":"_count"}},"language":"javascript"}
