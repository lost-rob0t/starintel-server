{"_id":"_design/messages","language":"javascript","views":{"messages_by_user":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='message'){emit(doc.user,doc._id);}}}","reduce":"_count"},"messages_by_platform":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='message'){emit(doc.platform,doc._id);}}}","reduce":"_count"},"messages_by_group":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='message'){emit(doc.group,doc._id);}}}","reduce":"_count"},"social_posts_by_user":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='socialmpost'){emit(doc.user,doc._id);}}}","reduce":"_count"},"social_posts_by_group":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='socialmediapost'){emit(doc.group,doc._id);}}}","reduce":"_count"},"by_channel":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='message'){if(doc.message!==''){emit([doc.group,doc.channel],doc._id);}}}}","reduce":"_count"},"messages_by_channel_time":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='message'&&doc.dateAdded){emit([doc.dateAdded,doc.group,doc.channel],doc._id);}}}","reduce":"function(keys,values,rereduce){if(rereduce){return values.flat().sort((a,b)=>a.dateAdded-b.dateAdded);}else{return values.sort((a,b)=>a.dateAdded-b.dateAdded);}}"},"social_posts_by_platform":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='socialmpost'){emit(doc.platform,doc._id);}}}","reduce":"_count"},"groups":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='message'&&doc.group&&doc.channel){emit(doc.group,doc.channel);}}}","reduce":"function(keys,values,rereduce){var channels=[];values.forEach(function(value){if(Array.isArray(value)){value.forEach(function(channel){if(channels.indexOf(channel)===-1){channels.push(channel);}});}else if(typeof value==='string'){if(channels.indexOf(value)===-1){channels.push(value);}}});return channels.sort();}"}}}
