{"_id":"_design/devices","language":"javascript","views":{"by_network_id":{"map":"function(doc){if(!doc||!doc._id)return;if(doc._id.indexOf('_design/')===0)return;if(!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='wireless-emitter')return;if(doc.networkId)emit(doc.networkId,doc._id);}"},"by_radio_type":{"map":"function(doc){if(!doc||!doc._id)return;if(doc._id.indexOf('_design/')===0)return;if(!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='wireless-emitter')return;if(doc.radioType)emit(doc.radioType,doc._id);}"},"by_label":{"map":"function(doc){if(!doc||!doc._id)return;if(doc._id.indexOf('_design/')===0)return;if(!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='wireless-emitter')return;if(doc.label)emit(doc.label,doc._id);}"},"by_seen_first":{"map":"function(doc){if(!doc||!doc._id)return;if(doc._id.indexOf('_design/')===0)return;if(!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='wireless-emitter')return;if(doc.seenFirst)emit(doc.seenFirst,doc._id);}"},"by_seen_last":{"map":"function(doc){if(!doc||!doc._id)return;if(doc._id.indexOf('_design/')===0)return;if(!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='wireless-emitter')return;if(doc.seenLast)emit(doc.seenLast,doc._id);}"},"by_seen_last_day":{"map":"function(doc){if(!doc||!doc._id)return;if(doc._id.indexOf('_design/')===0)return;if(!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='wireless-emitter')return;if(!doc.seenLast)return;var d=new Date(doc.seenLast*1000);var day=d.toISOString().slice(0,10);emit(day,doc._id);}"},"by_geo_bucket_3dp":{"map":"function(doc){if(!doc||!doc._id)return;if(doc._id.indexOf('_design/')===0)return;if(!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='wireless-emitter')return;var g=doc.geo;if(!g)return;var lat=g.lat,lon=g.lon;if(typeof lat!=='number'||typeof lon!=='number')return;var la=Math.round(lat*1000)/1000;var lo=Math.round(lon*1000)/1000;emit([la,lo],doc._id);}"},"by_dataset":{"map":"function(doc){if(!doc||!doc._id)return;if(doc._id.indexOf('_design/')===0)return;if(!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='wireless-emitter')return;if(doc.dataset)emit(doc.dataset,doc._id);}"},"count_by_radio_type":{"map":"function(doc){if(!doc||!doc._id)return;if(doc._id.indexOf('_design/')===0)return;if(!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='wireless-emitter')return;var r=doc.radioType||'radioType_missing';emit(r,1);}","reduce":"_count"},"count_by_day_last":{"map":"function(doc){if(!doc||!doc._id)return;if(doc._id.indexOf('_design/')===0)return;if(!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='wireless-emitter')return;if(!doc.seenLast)return;var d=new Date(doc.seenLast*1000);var day=d.toISOString().slice(0,10);emit(day,1);}","reduce":"_sum"},"best_signal_hist":{"map":"function(doc){if(!doc||!doc._id)return;if(doc._id.indexOf('_design/')===0)return;if(!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='wireless-emitter')return;var s=doc.bestSignalDbm;if(typeof s!=='number')return;emit(s,1);}","reduce":"_sum"},"count_by_dataset":{"map":"function(doc){if(!doc||!doc._id)return;if(doc._id.indexOf('_design/')===0)return;if(!doc.dtype)return;var dt=(''+doc.dtype).toLowerCase();if(dt!=='wireless-emitter')return;var ds=doc.dataset||'dataset_missing';emit(ds,1);}","reduce":"_count"}}}
