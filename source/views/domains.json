{"_id":"_design/domains","views":{"by_record":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='domain'&&doc.record){emit(doc.record,doc._id);}}}"},"by_record_type":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='domain'&&doc.recordType){emit(doc.recordType,doc._id);}}}"},"by_record_and_type":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='domain'&&doc.record&&doc.recordType){emit([doc.record,doc.recordType],doc._id);}}}"},"by_resolved_address":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='domain'&&doc.resolvedAddresses&&Array.isArray(doc.resolvedAddresses)){for(var i=0;i<doc.resolvedAddresses.length;i++){emit(doc.resolvedAddresses[i],doc._id);}}}}"},"count_by_record_type":{"map":"function(doc){if(doc.dtype){var dt=(''+doc.dtype).toLowerCase();if(dt==='domain'&&doc.recordType){emit(doc.recordType,1);}}}","reduce":"_count"}},"language":"javascript"}
